# Copia este archivo a .env SOLO si no tienes ya un .env.
# Completa los valores vacíos. No guardes credenciales en .gitignore.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Usa los valores reales del servicio MySQL en Railway.
DB_NAME=railway
DB_USER=root
DB_PASSWORD=
# Solo el dominio público de Settings > Networking > TCP Proxy.
# Ejemplo de formato: nombre.proxy.rlwy.net (no es un servidor real).
DB_HOST=
# Puerto EXTERNO del TCP Proxy; no asumir que sea 3306.
DB_PORT=
